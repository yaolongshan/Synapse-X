{
    "version": 8,
    "configurePresets": [
        {
            "name": "template",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "windows-x64",
            "displayName": "Windows x64 — Host",
            "description": "Ninja + MSVC x64（CLion 自带 CMake 不支持 VS 2026 生成器）",
            "inherits": "template",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build_x64"
        }
    ],
    "buildPresets": [
        {
            "name": "release",
            "displayName": "Host RelWithDebInfo",
            "configurePreset": "windows-x64"
        },
        {
            "name": "debug",
            "displayName": "Host Debug",
            "configurePreset": "windows-x64"
        }
    ]
}
